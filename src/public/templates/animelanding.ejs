<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>rranime - Watch Anime Online Free</title>
    <link rel="stylesheet" href="https://rranime.online/css/animelanding.css">
    <link rel="stylesheet" href="https://rranime.online/css/animeheader.css">
    <link rel="stylesheet" href="https://rranime.online/css/animefooter.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
<%- include('animeheader') %>
    <main>
        <div class="hero-section">
            <div class="announcement-badge">
                <span class="badge-pulse-dot"></span>
                Over 10,000+ anime titles streaming in HD
            </div>
            <h1>Find Your Next <span class="highlight-text">Anime</span></h1>
            <p class="hero-description">
                Stream completely free without forcing mandatory account sign-ups or endless intrusive ads.
            </p>
        </div>
        <div class="search-container">
            <form action="/search" method="GET" class="search-bar-wrapper">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" name="keyword" autocomplete="off" placeholder="Search anime by title, studio, or genre..." class="search-input">
                <button type="submit" class="search-submit-btn">
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>
        </div>
        <div class="trending-tags-container">
            <span class="trending-title">Trending:</span>
            <% trending.forEach(anime => { %>
                <a href="/anime/<%= anime.mal_id %>" class="tag-link">
                    <%= anime.title %>
                </a>
            <% }); %>
        </div>
        <div class="portal-container">
            <a href="/home" class="portal-cta-btn">
                Go to Full Homepage
                <i class="fa-solid fa-circle-play"></i>
            </a>
        </div>
    </main>
<%- include('animefooter') %>