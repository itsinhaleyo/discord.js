<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - <%= username %></title>
    <%- include('icon') %>
    <link rel="stylesheet" href="https://itsinhaleyo.online/css/header.css">
    <link rel="stylesheet" href="https://itsinhaleyo.online/css/profile.css">
    <script src="https://itsinhaleyo.online/script/profile.js" defer></script>
</head>
<body>
    <%- include('header') %>
    <div class="container">
        <img src="<%= avatarUrl %>" class="avatar">
        <h1>Welcome, <%= username %></h1>
        <div class="status-badge">● Secure via Cloudflare</div>
        <div id="discord-section">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">Balance</div>
                    <div class="stat-value">💰 <%= balance %></div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Level</div>
                    <div class="stat-value">⭐ <%= level %></div>
                </div>
            </div>
            <div class="stats-grid" style="margin-top: 20px;">
                <div class="stat-card">
                    <div class="stat-label">Claim Streak</div>
                    <div class="stat-value">🔥 <%= streak %> days</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Auto-Claim</div>
                    <div class="stat-value <%= autoclaimLeft !== 'Inactive' && autoclaimLeft !== 'Expired' ? 'active-sub' : 'inactive-sub' %>">⏱️ <%= autoclaimLeft %></div>
                </div>
            </div>
        </div>
        <div class="logout-section" style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.05);">
            <form action="/logout" method="POST">
                <button type="submit" class="btn-logout-special">
                    <span class="icon">🚀</span> Sign Out of Session
                </button>
            </form>
            <p style="color: var(--text-muted); font-size: 0.8rem; margin-top: 1rem;">
                Securely ends your session on this device.
            </p>
        </div>
        <a class="api-link" href="https://api.itsinhaleyo.online/">
            API Endpoints Available
        </a>
    </div>
    <div id="logout-modal" class="modal-overlay">
        <div class="modal-card">
            <div class="modal-icon">⚠️</div>
            <h2>Sign Out of Session?</h2>
            <p>Are you sure you want to end your active dashboard session on this device?</p>
            <div class="modal-actions">
                <button class="modal-btn-cancel" onclick="closeLogoutModal()">Cancel</button>
                <form action="/logout" method="POST" style="margin: 0; flex: 1;">
                    <button type="submit" class="modal-btn-confirm">Yes, Sign Out</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>