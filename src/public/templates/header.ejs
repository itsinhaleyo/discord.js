<header class="main-header">
    <script src="https://itsinhaleyo.online/script/header.js"></script>
    <div class="nav-container">
        <a href="/" class="logo">
            <img src="https://cdn.discordapp.com/avatars/1479879290270126263/baa2dc5e6d19d064dba7d62c5a6b0a4f.png" class="nav-logo">
            Jew
        </a>
        <div class="header-controls">
            <% if (typeof avatarUrl !== 'undefined' && avatarUrl) { %>
                <div class="notification-wrapper">
                    <a href="/notifications" class="notification-bell <%= (typeof unreadCount !== 'undefined' && unreadCount > 0) ? 'has-unread' : '' %>">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                            <span class="notification-badge"><%= unreadCount %></span>
                        <% } %>
                    </a>
                </div>
            <% } %>
            <button class="hamburger" id="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
        <nav class="nav-links" id="nav-links">
            <div class="shop">
                <a href="/shop">Shop</a>
            </div>
            <div class="dropdown">
                <button class="dropbtn" onclick="toggleDropdown(event, this)">Casino ▾</button>
                <div class="dropdown-content">
                    <a href="/lottery">🎫 Lottery</a>
                    <a href="/casino">🎰 Games</a>
                </div>
            </div>
            <div class="dropdown">
                <button class="dropbtn" onclick="toggleDropdown(event, this)">Crypto ▾</button>
                <div class="dropdown-content">
                    <a href="/portfolio">💰 Portfolio</a>
                    <a href="/trading">📈 Trade Assets</a>
                </div>
            </div>
            <div class="dropdown">
                <button class="dropbtn" onclick="toggleDropdown(event, this)">Leaderboards ▾</button>
                <div class="dropdown-content">
                    <a href="/leaderboard/money">💰 Money</a>
                    <a href="/leaderboard/rank">⭐ Rank</a>
                </div>
            </div>
            <% if (typeof avatarUrl !== 'undefined' && avatarUrl) { %>
                <a href="/profile" class="nav-avatar-link">
                    <img src="<%= avatarUrl %>" class="nav-user-avatar">
                </a>
            <% } else { %>
                <a href="/login" class="nav-login-btn">Login</a>
            <% } %>
        </nav>
    </div>
</header>