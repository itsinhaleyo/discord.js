<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>
    <%- include('icon') %>
    <link rel="stylesheet" href="https://itsinhaleyo.online/css/header.css">
    <link rel="stylesheet" href="https://itsinhaleyo.online/css/portfolio.css">
    <script src="https://itsinhaleyo.online/script/portfolio.js" defer></script>
</head>
<body>
    <%- include('header') %>
    <div class="container">
        <h1>Your Portfolio</h1>
        <div class="portfolio-header">
            <div class="p-stat"><div class="p-label">Cash</div><div class="p-value" id="top-cash">💰 <%= cash %></div></div>
            <div class="p-stat"><div class="p-label">Assets</div><div class="p-value" id="top-assets">📊 <%= assetValue %></div></div>
            <div class="p-stat">
                <div class="p-label">Total P/L</div>
                <div class="p-value" id="top-pnl">
                    <span id="global-pnl-render" style="color: #94a3b8;">
                        Calculating...
                    </span>
                </div>
            </div>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Asset</th>
                    <th>Shares / Position</th>
                    <th>Profit/Loss</th>
                </tr>
            </thead>
            <tbody>
                <% if (holdings && holdings.length > 0) { %>
                    <% holdings.forEach(stock => { %>
                        <tr class="portfolio-row" 
                            data-symbol="<%= stock.symbol.toUpperCase() %>"
                            data-network="<%= stock.network %>" 
                            data-contract="<%= stock.contract %>" 
                            data-shares="<%= stock.shares %>" 
                            data-entry="<%= stock.average_price %>"
                            data-margin="<%= stock.margin_used %>"
                            data-leverage="<%= stock.leverage %>"
                            data-side="<%= stock.side %>">
                            <td>
                                <strong><%= stock.symbol.toUpperCase() %></strong><br>
                                <small style="color: <%= stock.side === 'LONG' ? '#10b981' : '#ef4444' %>; font-size: 0.7rem; font-weight: bold;">
                                    <%= stock.leverage %>x <%= stock.side %>
                                </small>
                            </td>
                            <td>
                                <%= Number(stock.shares).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 8}) %><br>
                                <small style="color: var(--text-muted); font-size: 0.7rem;">
                                    Entry: $<%= Number(stock.average_price).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                                </small>
                            </td>
                            <td class="pos-pnl" style="color: #94a3b8; font-weight: bold;">
                                <span class="pnl-cash-value">Calculating...</span>
                                <div class="pnl-percent" style="font-size: 0.7rem; opacity: 0.8; font-weight: normal;">(--%)</div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="3" style="text-align: center; padding: 20px; color: var(--text-muted);">No holdings found</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>