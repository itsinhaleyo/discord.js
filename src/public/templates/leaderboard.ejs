<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <%- include('icon') %>
    <link rel="stylesheet" href="https://itsinhaleyo.online/css/header.css">
    <link rel="stylesheet" href="https://itsinhaleyo.online/css/leaderboard.css">
    <script src="https://itsinhaleyo.online/script/leaderboard.js" defer></script>
</head>
<body>
    <%- include('header') %>
    <div class="leaderboard-container">
        <h1><%= title %></h1>
        <form action="" method="GET" class="search-form" onsubmit="return false;">
            <div class="search-wrapper">
                <span class="search-icon">🔍</span>
                <input type="text" id="lbSearch" placeholder="Search by username..." class="search-input">
                <button type="button" class="search-btn" onclick="clearSearch()">Clear</button>
            </div>
        </form>
        <table>
            <thead>
                <tr>
                    <th style="text-align:center">Rank</th>
                    <th>User</th>
                    <th>Balance</th>
                    <th style="text-align:center">Level</th>
                </tr>
            </thead>
            <tbody>
                <% rows.forEach((user, index) => { 
                    const rank = index + 1;
                    const medal = rank === 1 ? '🥇' : rank === 2 ? '🥈' : rank === 3 ? '🥉' : rank;
                %>
                <tr>
                    <td style="text-align:center; font-weight: bold;"><%= medal %></td>
                    <td>
                        <div class="user-cell">
                            <img src="<%= getAvatar(user.userid, user.avatar) %>" class="user-avatar" alt=""> 
                            <span class="username"><%= user.username %></span>
                        </div>
                    </td>
                    <td class="balance-cell">💰<%= user.balance.toLocaleString() %></td>
                    <td style="text-align:center">
                        <span class="level-badge">⭐ <%= user.level %></span>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <div style="text-align: center; margin-top: 20px;">
            <a href="/" class="btn-back">← Back to Dashboard</a>
        </div>
    </div>
</body>
</html>